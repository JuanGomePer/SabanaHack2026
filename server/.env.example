# Copia este archivo a .env para desarrollo local.
# En Render estas variables se configuran en el dashboard del servicio
# (DATABASE_URL la pone Render automáticamente si usas su Postgres gestionado).

# Cadena de conexión de Postgres.
DATABASE_URL="postgresql://usuario@localhost:5432/vigia_dev"

# Puerto donde escucha la API en local. En Render y Railway manda PORT, que
# fija la plataforma; API_PORT solo se usa en desarrollo.
API_PORT=3001

# Clave que debe mandar el módulo de visión (o cualquier otro cliente externo)
# en el header `x-api-key` para poder publicar observaciones en
# POST /api/observaciones. Generar una distinta por entorno.
ROBOT_API_KEY="cambia-esto"

# Origen permitido por CORS para el frontend. En producción, la URL pública
# del sitio estático (ej. https://vigia-web.onrender.com).
CORS_ORIGIN="http://localhost:5173"

# ── Avisos al celular (canal de respaldo) ──────────────────────────────────
# Sin esto, los envíos quedan en modo simulado: se ven en la pantalla y en la
# bitácora, pero no sale ningún mensaje. Ver server/src/pasarela.ts y NOTAS.md.
# Cuál usar: simulado | twilio | whatsapp | telegram
SMS_PROVEEDOR=simulado

# Twilio · SMS de verdad. Ojo: la cuenta de prueba NO deja mandar texto propio
# (error 572006), solo plantillas fijas; la app reintenta con una, pero para el
# aviso real del cultivo hace falta cuenta de pago.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Alternativa a TWILIO_FROM si usas un Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=
# Plantilla con la que reintentar en cuentas de prueba:
TWILIO_PLANTILLA_TRIAL=sms_account_alerts

# WhatsApp por el sandbox de Twilio · gratis y con texto propio. Cada número
# tiene que mandar antes "join <código>" al sandbox desde su celular.
TWILIO_WHATSAPP_FROM=+14155238886

# Telegram · gratis, texto propio. /newbot con @BotFather, escribirle al bot y
# sacar el chat.id de https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
