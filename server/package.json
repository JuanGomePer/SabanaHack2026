    "express": "^5.3.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "4.19.2"
  }
