{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berryvision/observation/0.2.0",
  "title": "Observación de inspección fitosanitaria (propuesta v0.2.0)",
  "description": "Propuesta de contrato, no API implementada. confidence = confianza del modelo visual, NO probabilidad de infección. Los datos ambientales conservan sensor y fecha de origen.",
  "type": "object",
  "required": [
    "observation_id",
    "schema_version",
    "observed_at",
    "model_version",
    "image_reference",
    "camera_id",
    "location",
    "visual_findings",
    "environmental_context",
    "review_status"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "image_reference": {
      "type": "string",
      "minLength": 1,
      "description": "URI o clave del almacenamiento de evidencias; la imagen no viaja embebida"
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "properties": {
        "farm_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "greenhouse_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "nave"
        },
        "bed_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "cama"
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "visual_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_name",
          "confidence",
          "taxonomy"
        ],
        "properties": {
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "taxonomy": {
            "type": "string"
          },
          "bbox_xyxy": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "mask_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "depth_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "Fase posterior; null hasta validar el registro RGB-profundidad"
          },
          "point_xyz_m": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "point_frame_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "environmental_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variable",
          "value",
          "source_sensor_id",
          "measured_at"
        ],
        "properties": {
          "variable": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "source_sensor_id": {
            "type": "string",
            "minLength": 1
          },
          "measured_at": {
            "type": "string",
            "format": "date-time"
          },
          "distance_to_bed_m": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "review_status": {
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "needs_field_check"
      ]
    }
  }
}
