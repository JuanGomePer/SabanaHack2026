# Copia este archivo a .env.production.local (o pásalo como variable de
# build en Render) para que el sitio estático hable con la API desplegada.
# En desarrollo local no hace falta: el proxy de Vite resuelve /api contra
# http://localhost:3001 (ver vite.config.ts).
VITE_API_URL=https://vigia-api.onrender.com/api
